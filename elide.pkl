amends "elide:project.pkl"
import "elide:Sources.pkl" as Sources
import "elide:Jvm.pkl" as Jvm
import "elide:NativeImage.pkl" as NativeImage

name = "madura-javac"

local jdkTarget = 25
local kotlinTarget = "2.4"
local kotlinVersion = "2.4.0"
local truffleTarget = "25.2.4"
local gc = "serial"
local pkg = "dev.elide.jvm"
local entry = "\(pkg).JavacInvoker"

jvm {
  main = entry
  target = jdkTarget

  java {
    compiler {
      flags {
        "-Xlint:all"
        // Fix: Module path is not properly assembled for Kotlin, and kotlinc rejects modules without listing stdlib,
        // even when passing `-no-stdlib`.
        "--module-path=.dev/dependencies/m2/org/jetbrains/kotlin/kotlin-stdlib/\(kotlinVersion)/kotlin-stdlib-\(kotlinVersion).jar"
      }
    }
  }
}

kotlin {
  toolchain = "embedded"

  features {
    kapt = false
    kotlinx = false
    reflection = false
    defaultPlugins = false
  }
  compilerOptions {
    allWarningsAsErrors = true
    progressiveMode = true
    extraWarnings = true
    jvmTarget = jdkTarget
    includeRuntime = false
    javaParameters = true
    incremental = false
    noStdlib = true

    freeCompilerArgs {
      "-jvm-default=no-compatibility"
      "-Xcollection-literals"
      "-Xintrinsic-const-evaluation"
      "-Xexplicit-api=disable"
      "-Xemit-jvm-type-annotations"
      "-Xassertions=jvm"
      "-Xjsr305=strict"
      "-Xstring-concat=indy-with-constants"
      "-Xno-call-assertions"
      "-Xno-receiver-assertions"
      // Required for the CEntryPoint: Intrinsics.checkNotNullParameter takes the
      // word-typed params as Object, which native-image rejects.
      "-Xno-param-assertions"
      "-Xlambdas=indy"
      "-Xwhen-expressions=indy"
      "-Xjdk-release=\(jdkTarget)"
    }
  }
}

sources {
  ["main"] = new Sources.SourceSetSpec {
    paths {
      "src/*.kt"
    }
  }
  ["test"] = new Sources.SourceSetSpec {
    paths {
      "tests/*.kt"
    }
  }
}

testing {
  coverage {
    jvm {
      reports {
        Jvm.htmlReport()
        Jvm.xmlReport()
      }
    }
  }
}

artifacts {
  ["app"] = new Jvm.Jar {
    name = "app"
    main = entry
    sources { "main" }
  }

  // The shipped CLI: native-image builds `madura` as an executable whose
  // `main` (dev.elide.jvm.JavacInvoker) parses the `check`/`compile`/drop-in
  // modes and drives javac. Platform metadata is read from `$JAVA_HOME` at
  // runtime, so the binary ships alone.
  ["native"] = new NativeImage.NativeImage {
    from { "app" }
    name = "madura"
    type = "binary"
    entrypoint = entry

    options {
      driverMode = "external"
      optimization = "2"

      flags {
        "-march=compatibility"
        "--gc=\(gc)"
        "--emit=build-report"
        "--exact-reachability-metadata"
        "--enable-sbom=cyclonedx,export"
        "--future-defaults=all"
        "-R:MinHeapSize=32m"
        "-R:MaxHeapSize=1g"
        "-H:+UnlockExperimentalVMOptions"
        "-H:+UseSystemLocale"
        "-H:+BlindConstants"
        "-H:-CheckToolchain"
        "-H:+AllowJRTFileSystem"
        "-H:+RelativeCodePointers"
        "-H:+TrackPrimitiveValues"
        "-H:+TrackAccessChain"
        "-H:+PreserveFramePointer"
        "-H:+OptDeDuplication"
        "-H:+ReportExceptionStackTraces"
        "-H:+UseCompressedReferences"
        "-H:-ParseRuntimeOptions"
        "-H:+ReduceCodeSize"
        "-H:+UseServiceLoaderFeature"
        "-H:IncludeResourceBundles=com.sun.tools.javac.resources.compiler"
        "-H:IncludeResourceBundles=com.sun.tools.javac.resources.javac"
        "-H:IncludeResourceBundles=com.sun.tools.javac.resources.version"
        "-H:ConfigurationFileDirectories=native-image"
        "-H:CStandard=C11"
        "-H:DefaultCharset=UTF-8"
        // Full symbols, no obfuscation: profilers and a flamegraph need every
        // method to keep its name. `-g` adds DWARF (file:line attribution);
        // DeleteLocalSymbols would otherwise strip the symtab.
        "-g"
        "-H:-DeleteLocalSymbols"
        "-H:-UnlockExperimentalVMOptions"
        "-J--enable-native-access=org.graalvm.truffle"
        "-J--add-exports=jdk.graal.compiler/jdk.graal.compiler.lir.phases=ALL-UNNAMED"
      }
      classInit {
        buildtime {
          "sun.nio.fs.LinuxFileSystem"
          "sun.nio.fs.LinuxFileSystemProvider"
          "sun.nio.fs.MacOSXFileSystem"
          "sun.nio.fs.MacOSXFileSystemProvider"
        }
      }
    }
  }
}
